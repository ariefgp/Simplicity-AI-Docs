          "conditions": [ { "id": "d731ed42-b537-43f2-9f74-7ec1d6b7bb2c", "leftValue": "={{ ['booked','dnd-stop','not-interested','transferred-office'].some(t => ($json.contact?.tags || []).includes(t)) }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
