            { "id": "d2ad122b-6e34-492d-9d12-81cc6145c53e", "name": "voice_agent_id", "value": "YOUR_VOICE_AGENT_ID", "type": "string" },
            { "id": "d0551d3f-2b4a-4819-a5c3-c1f9c0fc68e8", "name": "clinic_tz", "value": "America/Chicago", "type": "string" },
