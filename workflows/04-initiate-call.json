    {
      "parameters": {
        "jsCode": "const tz = $('Clinic Config').first().json.clinic_tz;\nconst hour = parseInt(new Intl.DateTimeFormat('en-US',\n  { hour: 'numeric', hour12: false, timeZone: tz }).format(new Date()));\nreturn [{ json: { ...$('Validate Phone').first().json, inWindow: hour >= 9 && hour < 21 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "2c7b54cd-cd71-457f-8718-2b91fb0d8ceb",
      "name": "Check Window",
      "position": [1328, -160]
    },
