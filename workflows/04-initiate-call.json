      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_WITH_YOUR_RETELL_CREDENTIAL", "name": "Retell Header Auth" } },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=https://services.leadconnectorhq.com/contacts/{{ $('Validate Phone').first().json.contactId }}",
        "authentication": "genericCredentialType",
