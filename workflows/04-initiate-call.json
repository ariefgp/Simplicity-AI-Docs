          "conditions": [ { "id": "5e98a4c9-3b14-4ef5-b42a-1ea09e180755", "leftValue": "={{ $json.inWindow }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      },
