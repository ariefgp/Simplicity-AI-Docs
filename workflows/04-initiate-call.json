      "name": "Clinic Config",
      "position": [224, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $('Webhook').first().json.body;\nconst raw = (b.phone || '').replace(/[\\s\\-().]/g, '');\nconst e164 = /^\\+[1-9]\\d{7,14}$/;\nconst phone = raw.startsWith('+') ? raw : (raw.length === 10 ? '+1' + raw : raw);\nreturn [{ json: {\n  valid: e164.test(phone),\n  phone,\n  contactId: b.contact_id,\n  opportunityId: b.opportunity_id || '',\n  firstName: b.first_name || '',\n  lastName: b.last_name || '',\n  service: b.service_of_interest || '',\n  attempt: String(b.attempt || '1'),\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "59252cb3-f1cd-4e1e-9cb5-5461e0d3c1e0",
      "name": "Validate Phone",
      "position": [448, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 3 },
          "conditions": [ { "id": "99ed336e-6e71-41af-a69a-392219c2fd12", "leftValue": "={{ $json.valid }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "id": "d7c3fdbe-c3a1-4bec-8aa7-2d9bdb847948",
      "name": "IF Valid",
      "position": [672, 0]
    },
    {
