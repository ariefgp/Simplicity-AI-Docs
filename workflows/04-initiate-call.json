        "headerParameters": { "parameters": [ { "name": "Version", "value": "2021-07-28" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"customFields\": [ { \"id\": \"{{ $('Clinic Config').first().json.field_attempt_count }}\", \"value\": \"{{ $('Validate Phone').first().json.attempt }}\" } ] }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
