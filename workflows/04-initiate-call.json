        "headerParameters": { "parameters": [ { "name": "Version", "value": "2021-07-28" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"tags\": [\"invalid-phone\"] }",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "id": "ce65c280-55b3-460c-93d8-8a8d525d62b6",
