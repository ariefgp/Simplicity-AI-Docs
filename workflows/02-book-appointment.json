      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [ { "id": "d69a8f83-06a2-4290-9188-8e9e33abfa5f", "leftValue": "={{ ($json.contact?.tags || []).includes('booked') }}", "rightValue": "", "operator": { "type": "boolean", "operation": "true", "singleValue": true } } ],
          "combinator": "and"
