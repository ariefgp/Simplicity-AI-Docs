      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nconst args = body.args || {};\nconst rawOpp = args.opportunity_id || '';\n// Retell may pass an unresolved template like \"{{opportunity_id}}\" when the\n// channel (chat) has no opportunity_id dynamic variable. Treat that as empty\n// so the Find Opportunity contact-lookup fallback runs.\nconst opportunityId = rawOpp.includes('{{') ? '' : rawOpp;\nreturn [{ json: {\n  contactId: args.contact_id,\n  slotStart: args.slot_start,\n  opportunityId,\n  notes: args.notes || '',\n  callId: body.call?.call_id || 'unknown',\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [416, 0],
      "id": "ae7d6640-ad1b-4fd4-b10e-013f68a103c3",
