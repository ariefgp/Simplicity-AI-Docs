            { "id": "6420b011-ca9c-4f57-a9ef-981f4ac1663e", "name": "calendar_id", "value": "YOUR_CALENDAR_ID", "type": "string" },
            { "id": "4e292df7-c377-4e82-9575-cc73b516ebf0", "name": "location_id", "value": "YOUR_LOCATION_ID", "type": "string" },
            { "id": "935f7b71-fbfd-4d4e-afa1-14dceb290fb9", "name": "booked_stage_id", "value": "YOUR_STAGE_BOOKED", "type": "string" },
            { "id": "0b4d3b61-eed1-41ad-ad30-ef7274c7ac6b", "name": "pipeline_id", "value": "YOUR_PIPELINE_ID", "type": "string" },
            { "id": "f2df4b71-0fe1-4a72-bde1-7c48898cb01f", "name": "clinic_tz", "value": "America/Chicago", "type": "string" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [208, 0],
      "id": "ca900060-774a-465a-93d1-027d97ec4860",
      "name": "Clinic Config"
    },
    {
