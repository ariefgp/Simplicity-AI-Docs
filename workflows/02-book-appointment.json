      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const slot = $('Extract Args').first().json.slotStart;\nconst tz = $('Clinic Config').first().json.clinic_tz;\nconst human = new Intl.DateTimeFormat('en-US', {\n  weekday: 'long', month: 'long', day: 'numeric',\n  hour: 'numeric', minute: '2-digit', timeZone: tz,\n}).format(new Date(slot));\nreturn [{ json: {\n  response: `Booked successfully for ${human}. Confirm the details to the lead, then proceed to transfer.`\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1712, -144],
      "id": "f5d25ddb-e377-40dc-8577-7e96ba5d117d",
      "name": "Format Success"
    },
    {
      "parameters": { "options": { "responseCode": 200 } },
