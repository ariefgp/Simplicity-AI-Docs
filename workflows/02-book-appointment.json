      "parameters": {
        "assignments": { "assignments": [ { "id": "4ebfcd67-60fd-4fb0-a800-e36cdaf299ac", "name": "alert", "value": "=Booking failed for contact {{ $('Extract Args').first().json.contactId }} slot {{ $('Extract Args').first().json.slotStart }}", "type": "string" } ] },
        "options": {}
      },
