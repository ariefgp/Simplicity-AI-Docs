      "position": [1600, 112],
      "parameters": { "jsCode": "const passed = ($('Extract Args').first().json.opportunityId || '').trim();\nconst found = (($json.opportunities || [])[0] || {}).id || '';\nreturn [{ json: { oppId: passed || found } }];" }
    },
